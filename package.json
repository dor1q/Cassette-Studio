{
  "name": "cassette-studio",
  "version": "2.3.10",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --config desktop/builder.json --win --x64 --publish never"
  },
  "dependencies": {
    "@bwip-js/browser": "^4.7.0",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5"
  },
  "main": "desktop/main.mjs",
  "description": "J-card and cassette label editor for Windows",
  "author": "Cassette Studio"
}
